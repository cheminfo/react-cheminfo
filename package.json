{
  "name": "react-cheminfo",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Assembled React components shared by the cheminfo sites: a Cite button and an ecosystem menu",
  "author": "Luc Patiny",
  "keywords": [
    "react",
    "cheminfo",
    "citation",
    "components"
  ],
  "type": "module",
  "exports": {
    "./core": "./lib/core.js",
    "./orbital": "./lib/orbital.js",
    "./ui": "./lib/ui.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build-storybook": "storybook build",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib storybook-static",
    "dev": "storybook dev -p 10815",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "cheminfo-font": "^1.28.0"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-cheminfo-react": "^20.1.0",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "molstar": "^5.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-science": "^23.0.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.5.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.18.0",
    "react": "^18.3.1 || >=19",
    "react-dom": "^18.3.1 || >=19",
    "react-science": "^20.6.2 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "molstar": "^5.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/react-cheminfo.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/react-cheminfo/issues"
  },
  "homepage": "https://github.com/cheminfo/react-cheminfo#readme",
  "peerDependenciesMeta": {
    "molstar": {
      "optional": true
    }
  }
}
