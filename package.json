{
  "name": "react-cheminfo",
  "version": "0.12.0",
  "license": "MIT",
  "description": "React components, hooks and framework-free helpers shared by the cheminfo sites: site chrome, citations, sharing, routing, pedagogy, charts, and the structure, orbital and 3D molecule viewers",
  "author": "Luc Patiny",
  "keywords": [
    "react",
    "cheminfo",
    "citation",
    "components"
  ],
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "exports": {
    "./core": "./lib/core.js",
    "./molecule3d": "./lib/molecule3d.js",
    "./orbital": "./lib/orbital.js",
    "./slides": "./lib/slides.js",
    "./spectra": "./lib/spectra.js",
    "./structure": "./lib/structure.js",
    "./ui": "./lib/ui.js",
    "./vite": "./lib/vite.js",
    "./styles/*.css": "./styles/*.css"
  },
  "bin": {
    "cheminfo-check-deploy": "bin/check-deploy.mjs",
    "cheminfo-check-tokens": "bin/check-tokens.mjs"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "styles"
  ],
  "scripts": {
    "build-storybook": "storybook build",
    "check-tokens": "node scripts/check-tokens.mjs --fallbacks styles src",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib storybook-static",
    "dev": "storybook dev -p 10815",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run check-tokens && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "cheminfo-font": "^1.28.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "benchmark": "^2.1.4",
    "chemical-elements": "^2.3.2",
    "eslint": "^9.39.5",
    "eslint-config-cheminfo-react": "^20.1.0",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "ml-dataset-iris": "^1.2.1",
    "ml-pca": "^4.1.1",
    "ml-signal-processing": "^2.2.2",
    "molstar": "^5.11.0",
    "openchemlib": "^9.25.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ocl": "^8.7.2",
    "react-science": "^23.0.0",
    "rimraf": "^6.1.3",
    "spectra-processor": "^5.0.0",
    "storybook": "^10.5.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.18.0",
    "ml-pca": "^4.1.1",
    "ml-signal-processing": "^2.2.2",
    "molstar": "^5.11.0",
    "openchemlib": "^9.24.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-ocl": "^8.7.1",
    "react-science": "^20.6.2 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "spectra-processor": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/react-cheminfo.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/react-cheminfo/issues"
  },
  "homepage": "https://github.com/cheminfo/react-cheminfo#readme",
  "peerDependenciesMeta": {
    "ml-pca": {
      "optional": true
    },
    "ml-signal-processing": {
      "optional": true
    },
    "molstar": {
      "optional": true
    },
    "openchemlib": {
      "optional": true
    },
    "react-ocl": {
      "optional": true
    },
    "spectra-processor": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
